# Server Config
PORT=5000
NODE_ENV=development
CORS_ORIGIN=*

# PostgreSQL Connection String (Neon requires ?sslmode=require)
# Use pooled URL for DATABASE_URL (for app queries) and direct URL for DIRECT_URL (for migrations)
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.neon.tech/localconnect?sslmode=require"
DIRECT_URL="postgresql://user:password@ep-xxxx.neon.tech/localconnect?sslmode=require"

# JWT Secrets & Expiry
JWT_ACCESS_SECRET=your_jwt_access_secret_key_change_in_production
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_change_in_production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
